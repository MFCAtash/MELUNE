# =============================================================================
# MELUNE — automatic Let's Encrypt TLS
# =============================================================================
# Use this file for the FIRST deployment only:
#   1. In Cloudflare, set the `music` and `music-media` records to
#      "DNS only" (grey cloud) so Let's Encrypt can reach the origin on
#      ports 80/443. Leave every other record in the zone untouched.
#   2. Start the stack with CADDYFILE=Caddyfile.
#   3. Once certificates exist, switch to Cloudflare Origin Certificate
#      (CADDYFILE=Caddyfile.origin) and turn the orange cloud back on.
#
# Do not leave this mode active with the proxy enabled: Cloudflare terminates
# TLS, so the ACME HTTP-01 / TLS-ALPN-01 challenges cannot complete.
# =============================================================================
{
	email {$ACME_EMAIL}

	# Learn the real client IP from Cloudflare instead of logging/forwarding the
	# Cloudflare edge address. `private_ranges` covers Docker/LAN hops; the
	# explicit ranges are Cloudflare's published IPv4 + IPv6 blocks.
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

import site.caddy

# The app itself (music.melune.app).
{$DOMAIN} {
	import melune_site
}

# Public object storage (music-media.melune.app).
# Kept at one subdomain level on purpose: Cloudflare's free Universal SSL
# certificate covers `*.melune.app` but NOT second-level hosts such as
# media.music.melune.app.
{$MEDIA_DOMAIN} {
	import media_site
}
