# Copy to .env and fill in before `npm run start --workspace=apps/mobile`.
#   cp apps/mobile/.env.example apps/mobile/.env
#
# Must be prefixed EXPO_PUBLIC_ to be readable via process.env in app code
# (Expo's built-in client-env-var convention — see the Expo docs on
# environment variables). On a physical device / simulator this must be
# your machine's LAN IP, not localhost, since the API runs on your machine
# and the device is a separate network client.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
