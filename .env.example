# Copy this file to .env and fill in real values before running
# `npm run docker:up` or the apps individually.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://codex:codex_dev_password@localhost:5432/codex_music?schema=public
POSTGRES_USER=codex
POSTGRES_PASSWORD=codex_dev_password
POSTGRES_DB=codex_music

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Must be at least 32 characters (apps/api/src/config/env.validation.ts
# refuses to start otherwise) — this placeholder already is, but replace
# it for anything beyond local dev. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_dev_only_please_replace_before_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Storage (MinIO/S3)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=codex_minio
STORAGE_SECRET_KEY=codex_minio_secret
STORAGE_BUCKET=codex-music
STORAGE_PUBLIC_URL=http://localhost:9000/codex-music

# ---------------------------------------------------------------------------
# Audio transcode worker (HLS/adaptive bitrate — see
# docs/architecture.md's "Async Processing — Audio Transcode Queue"
# section). Optional: leave unset to use the default of 2.
# ---------------------------------------------------------------------------
TRANSCODE_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_FROM=noreply@codexmusic.dev

# ---------------------------------------------------------------------------
# Push (web-push VAPID keys — generate with `npm run generate:vapid`)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Recommendations (Phase 9 — hybrid content-based + collaborative mix, see
# apps/api/src/recommendations/hybrid-recommendations.service.ts). Optional:
# leave unset to use the default 0.6 / 0.4 split. Any invalid pair (missing,
# non-numeric, negative, or both zero) is ignored and the default is used —
# the two values are re-normalized to sum to 1 either way.
# ---------------------------------------------------------------------------
HYBRID_CONTENT_WEIGHT=0.6
HYBRID_COLLABORATIVE_WEIGHT=0.4

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Also the allowed origin for NotificationsGateway's Socket.io namespace
# (apps/api/src/notifications/notifications.gateway.ts) — no separate
# WS env var needed, it reads this same CORS_ORIGIN at connection time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used by docker-compose to configure MinIO's CORS allow-origin for the
# web app's offline-download feature (see infra note in docker-compose.yml).
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI service (services/ai — INITIAL SKELETON, not wired into docker-compose
# or the API yet; see services/ai/README.md). Not required to run
# `npm run docker:up`.
# ---------------------------------------------------------------------------
# Base URL the skeleton FastAPI service listens on.
AI_SERVICE_URL=http://localhost:8000
# Base URL the FastAPI skeleton proxies /recommend calls to — today this is
# just the existing NestJS API's real recommendation endpoint
# (GET /api/recommendations/for-you), not a separate ML model.
CODEX_API_URL=http://localhost:4000/api
