# =============================================================================
# MELUNE — production environment (Option B: single Oracle Cloud VM)
# =============================================================================
# This file is already pre-filled for the chosen address:
#
#   app    https://music.melune.app
#   media  https://music-media.melune.app   (kept at ONE subdomain level so the
#                                            free Cloudflare Universal SSL
#                                            certificate covers it — Universal
#                                            SSL does not cover second-level
#                                            hosts like media.music.melune.app)
#
# Copy it to `.env.production` on the server and replace every CHANGE_ME:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Or generate everything (secret + domain) in one shot:
#
#   ./scripts/deploy/configure-domain.sh music.melune.app
#
# Never commit .env.production — it is listed in .gitignore.
#
# Passwords below are embedded in a connection URL, so use URL-safe characters
# only (A-Z a-z 0-9 - _). Generate them with:
#
#   openssl rand -hex 24
#
# The same value must appear in POSTGRES_PASSWORD and inside DATABASE_URL.
# =============================================================================

# -----------------------------------------------------------------------------
# Domain + TLS
# -----------------------------------------------------------------------------
# App host, no scheme. This is a subdomain of an existing Cloudflare zone
# (melune.app) that already hosts another project, so only `music` and
# `music-media` records are touched — the apex/www records stay as they are.
DOMAIN=music.melune.app

# Public object-storage host. Must stay at the FIRST subdomain level of the
# zone for the free Universal SSL certificate to cover it.
MEDIA_DOMAIN=music-media.melune.app

# Let's Encrypt account email. Only used when CADDYFILE=Caddyfile.
ACME_EMAIL=admin@melune.app

# Caddyfile        -> automatic Let's Encrypt (first boot; needs the `music`
#                     and `music-media` DNS records set to "DNS only").
# Caddyfile.origin -> Cloudflare Origin Certificate (recommended; files at
#                     infra/caddy/origin.pem + origin.key, valid 15 years).
CADDYFILE=Caddyfile

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=melune
POSTGRES_PASSWORD=CHANGE_ME_url_safe_password
POSTGRES_DB=melune

# Host must be the compose service name `postgres`, not localhost.
DATABASE_URL=postgresql://melune:CHANGE_ME_url_safe_password@postgres:5432/melune?schema=public&connection_limit=10&pool_timeout=20

# -----------------------------------------------------------------------------
# Redis (cache, Socket.IO adapter, BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# JWT — must be at least 32 characters (env.validation.ts enforces this)
# -----------------------------------------------------------------------------
# openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars_minimum_0000000000000000000000000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Public URLs + CORS
# -----------------------------------------------------------------------------
# Same-origin deployment: leave NEXT_PUBLIC_API_URL EMPTY so the browser calls
# /api/* and /socket.io/* on the site domain (Caddy proxies them to the API).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://music.melune.app

# Server-side (React Server Components) fetch target inside the Docker network.
API_INTERNAL_URL=http://api:4000

# Used for CORS on the HTTP API and the Socket.IO handshake, and for the
# MinIO CORS header. No spaces, no trailing slash.
CORS_ORIGIN=https://music.melune.app
WEB_APP_URL=https://music.melune.app

# -----------------------------------------------------------------------------
# Object storage (MinIO behind Caddy at MEDIA_DOMAIN)
# -----------------------------------------------------------------------------
# The endpoint is the PUBLIC URL because presigned PUT URLs must be reachable
# from the browser. Caddy proxies MEDIA_DOMAIN to the MinIO container.
STORAGE_ENDPOINT=https://music-media.melune.app
STORAGE_PUBLIC_URL=https://music-media.melune.app/melune-music
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key
STORAGE_BUCKET=melune-music

# -----------------------------------------------------------------------------
# Audio transcode worker (ffmpeg -> HLS 128k/192k/320k)
# -----------------------------------------------------------------------------
TRANSCODE_WORKER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Recommendations (hybrid content + collaborative weights; must sum ~1)
# -----------------------------------------------------------------------------
HYBRID_CONTENT_WEIGHT=0.6
HYBRID_COLLABORATIVE_WEIGHT=0.4

# -----------------------------------------------------------------------------
# Mail + Web Push
# -----------------------------------------------------------------------------
# Keep the sender on the apex zone: music.melune.app has no MX/SPF records.
MAIL_FROM=noreply@melune.app

# Generate a pair with: npm run generate:vapid --workspace=apps/api
# Leaving both empty disables Web Push; setting only one is a startup error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Image tag used by docker-compose.prod.yml. Keep "latest" unless you deploy
# immutable tags from CI.
# -----------------------------------------------------------------------------
IMAGE_TAG=latest
