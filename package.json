{
  "name": "melune",
  "private": true,
  "version": "1.0.1",
  "description": "MELUNE — Your Music. Smarter. Full-stack music streaming and discovery platform.",
  "keywords": [
    "music-streaming",
    "nextjs",
    "nestjs",
    "prisma",
    "postgresql",
    "redis",
    "hls",
    "persian",
    "rtl",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MFCAtash/MELUNE.git"
  },
  "homepage": "https://github.com/MFCAtash/MELUNE#readme",
  "bugs": {
    "url": "https://github.com/MFCAtash/MELUNE/issues"
  },
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "start:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:up": "docker compose -f docker-compose.yml up --build",
    "docker:down": "docker compose -f docker-compose.yml down",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=apps/api",
    "lockfile:generate": "bash scripts/bootstrap-lockfile.sh",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "covers:themes": "node scripts/generate-theme-covers.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next": "14.2.13"
  }
}
